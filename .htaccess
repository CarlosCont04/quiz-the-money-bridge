Options -Indexes
RewriteEngine On
# Solo el resultado de la compilación es público.
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:backend|database|shared|src|scripts|tests|docs|node_modules|vendor|public)(?:/|$) - [F,L,NC]
RewriteRule ^(?:package.*\.json|composer\.(?:json|lock)|astro\.config\.mjs|tsconfig\.json|README\.md|playwright\.config\.ts)$ - [F,L,NC]
RewriteRule ^$ dist/ [L]
RewriteRule ^(?!dist/)(.*)$ dist/$1 [L]
